generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  MAIN_ADMIN
  DIRECTOR
  CLASS_LEADER
  TEACHER
  STUDENT
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  ARCHIVED
  DRAFT
  PUBLISHED
}

enum GradeValue {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
  NINE
  TEN
  ELEVEN
  TWELVE
}

enum AttendanceState {
  PRESENT
  ABSENT
  LATE
  NB
}

enum BehaviorDirection {
  POSITIVE
  NEGATIVE
}

enum CorrectionDecision {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                    String        @id @default(cuid())
  email                 String        @unique
  passwordHash          String
  firstName             String?
  lastName              String?
  phone                 String?
  isActive              Boolean       @default(false)
  mustChangePassword    Boolean       @default(true)
  schoolId              String?
  school                School?       @relation(fields: [schoolId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  roles                 UserRole[]
  auditLogs             AuditLog[]
  gradeCorrections      GradeCorrectionRequest[] @relation("RequestAuthor")
  attendanceCorrections AttendanceCorrectionRequest[] @relation("AttendanceRequestAuthor")
  behaviorCorrections   BehaviorReviewRequest[] @relation("BehaviorRequestAuthor")
  notifications         Notification[]
  lessons               Lesson[]
  assignments          TeacherSubjectAssignment[]
  schoolAnnouncements   Announcement[]
  verificationCodes     StudentVerificationCode[]
  accountActivations    AccountActivationToken[]
  studentRelations      Student[]
  directorRelations      Director[]
  teacherRelations       Teacher[]
  classLeaderRelations  ClassLeader[]
}

model Role {
  id          String     @id @default(cuid())
  name        RoleName   @unique
  description String?
  permissions Permission[]
  userRoles   UserRole[]
  createdAt   DateTime   @default(now())
}

model Permission {
  id          String     @id @default(cuid())
  key         String     @unique
  description String?
  roles       Role[]
  createdAt   DateTime   @default(now())
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model School {
  id          String       @id @default(cuid())
  name        String
  shortName   String?
  city        String?
  address     String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  status      Status       @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  directors   Director[]
  teachers    Teacher[]
  students    Student[]
  classes     Class[]
  kindergartens Kindergarten[]
  announcements Announcement[]
  news        News[]
  libraryResources LibraryResource[]
  achievements Achievement[]
}

model Kindergarten {
  id          String   @id @default(cuid())
  name        String
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  address     String?
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Director {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  subjectIds   String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignments TeacherSubjectAssignment[]
}

model Student {
  id                     String   @id @default(cuid())
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id])
  schoolId               String
  school                 School   @relation(fields: [schoolId], references: [id])
  classId                String?
  class                 Class?   @relation(fields: [classId], references: [id])
  studentNumber          String?
  gender                 String?
  birthDate             DateTime?
  verificationCode       String?
  status                 Status   @default(ACTIVE)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  transfers             StudentTransfer[]
  gradeRecords          Grade[]
  attendanceRecords     Attendance[]
  behaviorRecords       BehaviorRecord[]
  feedback              StudentFeedback[]
  homeworkSubmissions   HomeworkSubmission[]
  achievements         Achievement[]
  verificationCodes     StudentVerificationCode[]
}

model Class {
  id          String    @id @default(cuid())
  name        String
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  yearId      String?
  academicYear AcademicYear? @relation(fields: [yearId], references: [id])
  classLeaders ClassLeader[]
  students    Student[]
  journals    Journal[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ClassLeader {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([classId, userId])
}

model AcademicYear {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      Status   @default(DRAFT)
  classes     Class[]
  journals    Journal[]
  terms       AcademicTerm[]
  createdAt   DateTime @default(now())
}

model AcademicTerm {
  id          String   @id @default(cuid())
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  name        String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String?
  createdAt   DateTime @default(now())
  assignments TeacherSubjectAssignment[]
  journalSubjects JournalSubject[]
}

model TeacherSubjectAssignment {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id])
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  classId     String?
  createdAt   DateTime @default(now())

  @@unique([teacherId, subjectId])
}

model Journal {
  id              String   @id @default(cuid())
  classId         String
  class           Class    @relation(fields: [classId], references: [id])
  academicYearId  String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  title           String
  status          Status   @default(DRAFT)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  journalSubjects JournalSubject[]
}

model JournalSubject {
  id          String   @id @default(cuid())
  journalId   String
  journal     Journal  @relation(fields: [journalId], references: [id])
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  sectionCount Int     @default(1)
  createdAt   DateTime @default(now())
  lessons     Lesson[]
  grades      Grade[]

  @@unique([journalId, subjectId])
}

model JournalSection {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
}

model Lesson {
  id              String   @id @default(cuid())
  journalSubjectId String
  journalSubject  JournalSubject @relation(fields: [journalSubjectId], references: [id])
  teacherId       String?
  teacher         User?    @relation(fields: [teacherId], references: [id])
  topic           String?
  lessonDate      DateTime
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  grades          Grade[]
  attendance      Attendance[]
  behaviorRecords BehaviorRecord[]
}

model Grade {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  journalSubjectId  String
  journalSubject    JournalSubject @relation(fields: [journalSubjectId], references: [id])
  lessonId          String?
  lesson            Lesson?  @relation(fields: [lessonId], references: [id])
  teacherId         String?
  value            Int?
  comment          String?
  createdAt        DateTime @default(now())
  correctionRequests GradeCorrectionRequest[]
}

model GradeCorrectionRequest {
  id              String   @id @default(cuid())
  gradeId         String
  grade           Grade    @relation(fields: [gradeId], references: [id])
  requestAuthorId String
  requestAuthor   User     @relation("RequestAuthor", fields: [requestAuthorId], references: [id])
  oldValue        Int?
  proposedValue   Int?
  finalValue      Int?
  reason          String
  decision        CorrectionDecision @default(PENDING)
  decisionReason  String?
  directorId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Attendance {
  id              String   @id @default(cuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id])
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  state           AttendanceState
  note            String?
  createdAt       DateTime @default(now())
  correctionRequests AttendanceCorrectionRequest[]
}

model AttendanceCorrectionRequest {
  id               String   @id @default(cuid())
  attendanceId     String
  attendance       Attendance @relation(fields: [attendanceId], references: [id])
  requestAuthorId  String
  requestAuthor    User     @relation("AttendanceRequestAuthor", fields: [requestAuthorId], references: [id])
  reason           String
  proposedState    AttendanceState?
  decision         CorrectionDecision @default(PENDING)
  decisionReason   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BehaviorScale {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       BehaviorScaleItem[]
}

model BehaviorScaleItem {
  id          String   @id @default(cuid())
  scaleId     String
  scale       BehaviorScale @relation(fields: [scaleId], references: [id])
  score       Int
  label       String
  description String?
  direction   BehaviorDirection
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
}

model BehaviorRecord {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  score       Int
  comment     String?
  createdAt   DateTime @default(now())
  reviewRequests BehaviorReviewRequest[]
}

model BehaviorReviewRequest {
  id              String   @id @default(cuid())
  behaviorRecordId String
  behaviorRecord  BehaviorRecord @relation(fields: [behaviorRecordId], references: [id])
  requestAuthorId String
  requestAuthor   User     @relation("BehaviorRequestAuthor", fields: [requestAuthorId], references: [id])
  reason          String
  decision        CorrectionDecision @default(PENDING)
  decisionReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BehaviorCorrection {
  id            String   @id @default(cuid())
  behaviorRecordId String
  previousScore Int?
  newScore      Int?
  reason        String?
  createdAt     DateTime @default(now())
}

model Homework {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id          String   @id @default(cuid())
  homeworkId  String
  homework    Homework @relation(fields: [homeworkId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  content     String?
  createdAt   DateTime @default(now())
}

model Schedule {
  id          String   @id @default(cuid())
  dayOfWeek   Int
  startTime   String
  endTime     String
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model News {
  id          String   @id @default(cuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  title       String
  slug        String   @unique
  content     String
  status      Status   @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

model Announcement {
  id          String   @id @default(cuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  title       String
  content     String
  status      Status   @default(DRAFT)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

model LibraryResource {
  id          String   @id @default(cuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  title       String
  summary     String?
  url         String?
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now())
}

model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  questions   TestQuestion[]
}

model TestQuestion {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id])
  question    String
  createdAt   DateTime @default(now())
}

model TestAttempt {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
}

model TestAnswer {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
}

model GalleryAlbum {
  id          String   @id @default(cuid())
  title       String
  createdAt   DateTime @default(now())
}

model GalleryMedia {
  id          String   @id @default(cuid())
  albumId     String
  kind        String
  url         String
  createdAt   DateTime @default(now())
}

model Application {
  id          String   @id @default(cuid())
  fullName    String
  email       String?
  message     String
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now())
}

model Achievement {
  id          String   @id @default(cuid())
  schoolId    String?
  school      School?  @relation(fields: [schoolId], references: [id])
  title       String
  description String?
  createdAt   DateTime @default(now())
  students    Student[]
}

model StudentFeedback {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  content     String
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  action      String
  entity      String?
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())
}

model Translation {
  id          String   @id @default(cuid())
  key         String
  language    String
  value       String
  createdAt   DateTime @default(now())

  @@unique([key, language])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AccountActivationToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model StudentVerificationCode {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  code        String   @unique
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime @default(now())
}

model StudentTransfer {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  fromClassId String?
  toClassId   String?
  transferDate DateTime @default(now())
  reason      String?
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String?
  subject     String?
  message     String
  createdAt   DateTime @default(now())
}
